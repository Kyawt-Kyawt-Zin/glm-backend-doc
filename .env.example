PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=golden_loom_myanmar
JWT_SECRET=write_random_private_secret_here
# Stable secret used to prevent deleted email addresses from registering again. Keep it safe and do not rotate without a migration.
ACCOUNT_DELETION_HMAC_KEY=replace_with_a_unique_random_secret_at_least_32_characters

# Email notifications are disabled until a provider is configured and tested.
WELCOME_EMAIL_ENABLED=false
ORDER_EMAIL_ENABLED=false
MAILER_GMAIL_USER=
MAILER_GMAIL_APP_PASSWORD=
CUSTOMER_SITE_URL=https://golden-loom-myanmar.vercel.app
# Random secret protecting the scheduled retry endpoint; never commit the real value.
CRON_SECRET=
